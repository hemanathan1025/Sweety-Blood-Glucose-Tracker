# Copy to .env and replace both placeholders before starting Docker.
POSTGRES_DB=sweety_db
POSTGRES_USER=sweety_app
DB_PASSWORD=replace-with-a-local-database-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
DB_POOL_MAX=10
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
FRONTEND_PORT=8080
BACKEND_PORT=5000
