# Express server and allowed frontend sites
PORT=5000
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# PostgreSQL connection for the existing sweety_db database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sweety_db
DB_USER=your_postgres_user
DB_PASSWORD=your_local_password
DB_POOL_MAX=10

# JWT settings used to sign login tokens
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d

# Optional demo account settings for the seed script
SEED_DEMO_EMAIL=demo@example.com
SEED_DEMO_PASSWORD=replace-with-a-local-demo-password
